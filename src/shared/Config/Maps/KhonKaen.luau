function Map.zoneAt(x: number, z: number)
	for _, zn in ipairs(Map.zones) do
		if x >= zn.x1 and x <= zn.x2 and z >= zn.z1 and z <= zn.z2 then return zn end
	end
	return Map.zones[#Map.zones]
end

-- Land use (density class) at a point: "core" | "urban" | "suburb" | "rural". The street planner used
-- the same table to decide where blocks get lanes, so buildings and streets agree.
Map.sites = Plan.sites
local LU = Plan.landUse
Map.landUseCfg = LU
-- 2026-11-18 (the whole of Tambon Nai Mueang): OpenStreetMap land use polygons first (university and
-- school grounds, hospitals and government land become "suburb": few big buildings; fields, grass and
-- military land "rural"), then the boxes, then rings round the centre (LU.suburbRadius, LU.ruralRadius).
-- tools/plan_streets.py applies the same rule when it decides where the few invented lanes go.
local POLY_CLASS = { campus = "suburb", green = "rural", military = "rural", industrial = "suburb", commercial = "urban" }
local POLY_RANK = { campus = 1, military = 1, green = 2, industrial = 3, commercial = 4, residential = 5 }
local LU_CELL = 512
local luGrid = {}
do
	for _, lu in ipairs(F.landuse or {}) do
		local p = lu.pts
		local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
		for i = 1, #p, 2 do
			minX = math.min(minX, p[i]); maxX = math.max(maxX, p[i]); minZ = math.min(minZ, p[i + 1]); maxZ = math.max(maxZ, p[i + 1])
		end
		lu.minX, lu.maxX, lu.minZ, lu.maxZ = minX, maxX, minZ, maxZ
		lu.rank = POLY_RANK[lu.use] or 9
		for cx = math.floor(minX / LU_CELL), math.floor(maxX / LU_CELL) do
			for cz = math.floor(minZ / LU_CELL), math.floor(maxZ / LU_CELL) do
				local k = cx * 65536 + cz
				local list = luGrid[k]
				if not list then list = {}; luGrid[k] = list end
				table.insert(list, lu)
			end
		end
	end
end
local function inPoly(p: { number }, x: number, z: number): boolean
	local c = false
	local n = #p
	local jx, jz = p[n - 1], p[n]
	for i = 1, n, 2 do
		local ix, iz = p[i], p[i + 1]
		if (iz > z) ~= (jz > z) and x < ix + (z - iz) * (jx - ix) / (jz - iz) then c = not c end
		jx, jz = ix, iz
	end
	return c
end
-- the OSM land use under a point ("campus" | "green" | "military" | "industrial" | "commercial" | "residential"), or nil
function Map.landUseRaw(x: number, z: number): string?
	local list = luGrid[math.floor(x / LU_CELL) * 65536 + math.floor(z / LU_CELL)]
	if not list then return nil end
	local best
	for _, lu in ipairs(list) do
		if x >= lu.minX and x <= lu.maxX and z >= lu.minZ and z <= lu.maxZ and (not best or lu.rank < best.rank) and inPoly(lu.pts, x, z) then
			best = lu
		end
	end
	return best and best.use or nil
end
function Map.landUse(x: number, z: number): string
	local dc = (x - LU.center[1]) ^ 2 + (z - LU.center[2]) ^ 2
	local raw = Map.landUseRaw(x, z)
	if raw and POLY_CLASS[raw] and raw ~= "commercial" then return POLY_CLASS[raw] end
	if dc < LU.coreRadius ^ 2 then return "core" end
	if raw == "commercial" then return "urban" end
	for _, b in ipairs(LU.boxes) do
		if x >= b.x1 and x <= b.x2 and z >= b.z1 and z <= b.z2 then return b.use end
	end
	if LU.ruralRadius and dc > LU.ruralRadius ^ 2 then return "rural" end
	if LU.suburbRadius and dc > LU.suburbRadius ^ 2 then return "suburb" end
	return "urban"
end

